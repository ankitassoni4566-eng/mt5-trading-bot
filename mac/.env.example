# Copy this file to .env and fill it in:   cp .env.example .env && open -e .env
# NEVER commit .env to GitHub.

# Where the SiliconMetaTrader5 bridge is listening.
# Use the host + port shown on the bridge app's "Bot connection" page.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8001

# MT5 account. Leave empty to use the account you already logged in to inside the bridge.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Telegram alerts + remote control (see README)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Only for real money: mode: live in config.yaml AND this exact phrase
LIVE_TRADING_CONFIRM=
