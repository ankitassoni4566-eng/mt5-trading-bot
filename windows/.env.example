# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# MT5 account (leave empty to use whatever account the open terminal is logged in to)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if you have several MT5 installs
MT5_PATH=

# Telegram alerts + remote control (see README)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Only for real money: mode: live in config.yaml AND this exact phrase
LIVE_TRADING_CONFIRM=
